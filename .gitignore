node_modules/
npm-debug.log*
.DS_Store

# Secrets — never commit these.
.env
.env.*
!.env.example
service-account*.json
*firebase-adminsdk*.json
google-application-credentials*.json

# Hasil `npm run render-env` — berisi nilai rahasia siap tempel ke Render.
render-env*.txt

# Local attachment blobs and anything else written at runtime.
/data/

# Cache Python dari skill agent, bukan bagian dari aplikasi.
__pycache__/
*.pyc

# Indeks lokal CodeGraph (dibuat ulang lewat `codegraph init`).
.codegraph/

# Android — kunci penandatangan APK. Kalau file ini hilang, APK berikutnya tidak
# bisa dipasang sebagai pembaruan (Android menolak tanda tangan berbeda) dan
# assetlinks-nya ikut berubah. Simpan salinannya di tempat aman.
android/android.keystore
android/keystore.properties

# Hasil build Android.
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.apk
*.aab
