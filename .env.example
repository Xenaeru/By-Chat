# Salin jadi .env lalu isi. Tanpa .env, aplikasi jalan di mode dev (tanpa Firebase,
# tanpa Supabase) — cukup buat nyoba di lokal, TIDAK boleh dipakai di server publik.

# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────
PORT=3000
# WAJIB di server beneran. NODE_ENV=production akan MENOLAK jalan kalau auth
# masih mode dev.
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# Login — Firebase Authentication
# Console: https://console.firebase.google.com  →  Project settings → Your apps
# Langkah: bikin project → Authentication → Sign-in method → aktifkan "Google".
#          (Login nomor HP/OTP SMS nggak dipakai: itu paket berbayar Firebase.)
# ─────────────────────────────────────────────────────────────────────────────
# AUTH_MODE=firebase otomatis kepilih kalau kredensial di bawah lengkap.
# Nilai yang boleh: firebase | dev
#AUTH_MODE=firebase

# Config publik (aman dilihat browser, memang dikirim ke client):
FIREBASE_API_KEY=
# Domain halaman login Firebase. Sebaiknya domain aplikasi ini sendiri
# (mis. bychat.web.id): server meneruskan /__/auth/* ke
# <project>.firebaseapp.com, sehingga login Google tetap di dalam APK.
# Kalau dibiarkan firebaseapp.com, login Google di APK berakhir balik ke layar
# login. Lihat docs/ANDROID.md bagian 3.
FIREBASE_AUTH_DOMAIN=namaproyek.firebaseapp.com
FIREBASE_PROJECT_ID=namaproyek
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=

# Kredensial server buat verifikasi ID token. Pilih SALAH SATU:
#   a) taruh file JSON-nya di mana saja dan set path ini (paling gampang):
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/ke/firebase-adminsdk-xxxx.json
#   b) atau tempel isi JSON-nya di sini sebagai SATU BARIS. Jangan diketik manual —
#      jalanin: node scripts/set-service-account.mjs "C:/path/ke/key.json"
FIREBASE_SERVICE_ACCOUNT=

# Opsional: arahkan ke Firebase Auth Emulator buat nguji tanpa kredensial asli.
# Jalanin: npx firebase-tools emulators:start --only auth
#FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ─────────────────────────────────────────────────────────────────────────────
# Kirim file — Supabase Storage
# Dashboard: https://supabase.com/dashboard  →  Storage → New bucket
# Bikin bucket PRIVATE (jangan public), lalu ambil keys di Project settings →
# API. SERVICE ROLE KEY itu kunci rahasia: cuma boleh dipakai server ini,
# JANGAN pernah ditaruh di kode client.
# ─────────────────────────────────────────────────────────────────────────────
# STORAGE_DRIVER=supabase otomatis kepilih kalau dua variabel di bawah diisi.
# Nilai yang boleh: supabase | local
#STORAGE_DRIVER=supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=attachments

# Dipakai kalau STORAGE_DRIVER=local (default tanpa Supabase). File terenkripsi
# ditulis ke disk. Ganti ke Supabase sebelum dipakai rame-rame.
#LOCAL_STORAGE_DIR=./data/attachments

# Foto profil disimpan di sini kalau STORAGE_DRIVER=local. Pakai Supabase, dia
# ikut masuk ke bucket yang sama (folder avatars/). Catatan penting: foto profil
# TIDAK dienkripsi — lihat README bagian "Apa yang bisa dilihat server".
#LOCAL_AVATAR_DIR=./data/avatars

# Batas ukuran file terenkripsi, dalam byte. PENTING kalau pakai Supabase:
# dia dibatasi PER OBJEK, dan satu file = satu objek. Free plan mentok 50 MB
# (dites: 51 MiB ditolak "413 EntityTooLarge"), jadi 45 MiB diberi ruang aman.
# Naikkan cuma kalau paket Supabase-mu sudah menaikkan batas objeknya.
MAX_UPLOAD_BYTES=47185920

# ─────────────────────────────────────────────────────────────────────────────
# Telpon — TURN (wajib kalau dijalankan di server beneran)
# STUN gratis udah dipakai otomatis, tapi STUN doang gagal di NAT ketat dan
# CGNAT operator seluler Indonesia (~10-20% panggilan). TURN yang bikin andal.
#   Twilio:  https://console.twilio.com → Network Traversal Service
#            (dia kasih ICE servers + credential)
#   Vonage:  https://dashboard.nexmo.com → Video / TURN
# Alternatif: self-host coturn (https://github.com/coturn/coturn)
# ─────────────────────────────────────────────────────────────────────────────
# Pisahkan beberapa URL dengan koma.
#TURN_URLS=turn:global.turn.twilio.com:3478?transport=udp,turn:global.turn.twilio.com:3478?transport=tcp
#TURN_USERNAME=
#TURN_CREDENTIAL=

# ─────────────────────────────────────────────────────────────────────────────
# Web Push — dering panggilan walau aplikasinya belum dibuka
# Nggak perlu diisi: kunci VAPID dibuat sekali lalu disimpan sendiri
# (registry/push.json di Supabase, atau data/push.json di driver local).
# Isi hanya kalau beberapa instance harus memakai kunci yang sama.
# ─────────────────────────────────────────────────────────────────────────────
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:admin@example.com

# ─────────────────────────────────────────────────────────────────────────────
# Username (@nama)
# Setiap akun WAJIB klaim satu username setelah login. Nggak perlu diatur —
# default-nya sudah benar. Dua baris ini cuma kalau kamu mau pindah tempat:
#   supabase -> disimpan sebagai objek di bucket (registry/usernames.json)
#   local    -> disimpan sebagai file JSON di bawah
# ─────────────────────────────────────────────────────────────────────────────
#USERNAME_STORE=./data/usernames.json
#USERNAME_STORE_OBJECT=registry/usernames.json

# ─────────────────────────────────────────────────────────────────────────────
# Admin — laporan pengguna & daftar blokir
# Halaman /admin.html hanya bisa dibuka akun yang tercantum di sini. Kosong =
# nggak ada admin, dan halaman itu menolak semua orang.
#   - Login Google punya email  -> isi ADMIN_EMAILS.
#   - Kalau akunnya nggak punya email (mis. akun mode dev) -> isi ADMIN_UIDS
#     dengan uid-nya.
# Boleh beberapa sekaligus, pisahkan dengan koma. Nilai yang berlaku selalu yang
# di server; halaman admin sendiri nggak bisa menambah admin.
#ADMIN_EMAILS=
#ADMIN_UIDS=

# Tempat laporan + blokir dan indeks email/nomor HP disimpan. Bentuknya sama
# seperti username: `supabase` -> objek di bucket, `local` -> file JSON di data/.
# Indeks itu yang bikin orang yang belum pernah online tetap bisa dicari dan
# di-chat lewat email/nomor — tanpa itu, nomornya harus disiarkan ke semua orang.
#MODERATION_STORE=./data/moderation.json
#MODERATION_STORE_OBJECT=registry/moderation.json
#ACCOUNT_STORE=./data/accounts.json
#ACCOUNT_STORE_OBJECT=registry/accounts.json

# Akun username + kata sandi (login tanpa Google). Isinya hash sandi dan kunci
# tanda tangan sesi, jadi file ini RAHASIA — jangan dibagikan atau di-commit.
# Kalau isinya dihapus, semua akun sandi hilang dan sesinya ikut berakhir.
#CREDENTIAL_STORE=./data/credentials.json
#CREDENTIAL_STORE_OBJECT=registry/credentials.json

CALLS_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# APK Android (Trusted Web Activity)
# APK-nya membuka aplikasi web ini di dalam Chrome, jadi tidak ada kode lain
# yang perlu diubah. Dua nilai di bawah harus SAMA dengan yang ada di
# android/twa-manifest.json, kalau tidak Chrome menampilkan APK sebagai Custom
# Tab biasa (ada address bar-nya) dan bukan aplikasi layar penuh.
# Lihat docs/ANDROID.md.
#ANDROID_PACKAGE_NAME=id.web.bychat
# Sidik jari SHA-256 sertifikat penandatangan APK. Ambil dengan:
#   keytool -list -v -keystore android/android.keystore -alias android | grep SHA256
# Pisahkan beberapa sidik jari dengan koma (mis. debug + release).
#ANDROID_SHA256_CERT_FINGERPRINTS=
